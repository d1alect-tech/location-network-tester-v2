{
  "name": "lnt-frontend-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-manifest.js",
    "build:check": "node scripts/build-check.js",
    "typecheck": "tsc --noEmit",
    "licenses:check": "node scripts/licenses-check.js",
    "preview": "vite preview",
    "lint": "biome check src/ bench/",
    "lint:write": "biome check --write src/ bench/",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "axe-core": "^4.13.0",
    "echarts": "^5.6.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
