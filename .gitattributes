# Byte-exact integrity receipts - never convert (hash-pinned by tests/test_pristine_gate.py)
.integrity/** -text
_recovery/RECOVERY.md -text

# Normalize first-party sources to LF so checkouts are deterministic across worktrees
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# LICENSE has no extension, so the *.txt pin above never reaches it: under
# core.autocrlf=true it materialized CRLF while LICENSES/GPL-3.0.txt is LF, and
# tests/test_dependency_policy.py compares the two byte-for-byte.
LICENSE text eol=lf
